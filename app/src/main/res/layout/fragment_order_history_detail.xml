            <!--                    android:drawableTint="@color/primary"-->
            <!--                    android:drawablePadding="6dp"-->
            <!--                    app:strokeColor="@color/primary"-->
            <!--                    app:strokeWidth="1.5dp"-->
            <!--                    app:cornerRadius="12dp"-->
