<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Create Product"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Hero Image Upload Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dashed_border"
                android:padding="24dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_camera"
                    app:tint="#888888"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload image here"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btn_upload_image"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Upload Image"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:drawableStart="@drawable/ic_add"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="22dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Add Thumbnail -->
<!--                <FrameLayout-->
<!--                    android:layout_width="64dp"-->
<!--                    android:layout_height="64dp"-->
<!--                    android:background="@drawable/bg_thumbnail_add"-->
<!--                    android:layout_marginEnd="10dp">-->

<!--                    <ImageView-->
<!--                        android:layout_width="20dp"-->
<!--                        android:layout_height="20dp"-->
<!--                        android:layout_gravity="center"-->
<!--                        android:src="@drawable/ic_add"-->
<!--                        app:tint="#999999" />-->

<!--                </FrameLayout>-->
<!--                <TextView-->
<!--                    android:layout_width="64dp"-->
<!--                    android:layout_height="64dp"-->
<!--                    android:background="@drawable/bg_icon_rounded"-->
<!--                    android:backgroundTint="@color/stroke_default"-->
<!--                    android:text="+"-->
<!--                    android:gravity="center"-->
<!--                    android:textSize="30dp"-->
<!--                    android:layout_marginRight="15dp"-->
<!--                    />-->

                <!-- Existing Thumbnail -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_product_detail"
                    android:background="@drawable/bg_icon_rounded"
                    android:clipToOutline="true" />

            </LinearLayout>

            <!-- Basic Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="18dp" />

                    <!-- Product Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Name"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_product_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="e.g. Premium Silk Blazer"
                        android:textColorHint="#BBBBBB"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:background="@drawable/bg_card_white_rounded"
                        android:backgroundTint="#F5F6FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:layout_marginBottom="18dp" />

                    <!-- Category -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/dropdown_category"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card_white_rounded"
                        android:backgroundTint="#F5F6FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="18dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Select Category"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <ImageView
                            android:id="@+id/dropdown"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_chevron_down"
                           />

                    </LinearLayout>

                    <!-- Initial Stock -->
<!--                    <TextView-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="Initial Stock"-->
<!--                        android:textSize="13sp"-->
<!--                        android:textColor="#666666"-->
<!--                        android:layout_marginBottom="6dp" />-->

<!--                    <EditText-->
<!--                        android:id="@+id/et_initial_stock"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="50dp"-->
<!--                        android:hint="0"-->
<!--                        android:hintTextColor="#BBBBBB"-->
<!--                        android:textColor="#111111"-->
<!--                        android:textSize="14sp"-->
<!--                        android:background="@drawable/bg_card_white_rounded"-->
<!--                        android:backgroundTint="#F5F6FA"-->
<!--                        android:paddingStart="14dp"-->
<!--                        android:paddingEnd="14dp"-->
<!--                        android:singleLine="true"-->
<!--                        android:inputType="number"-->
<!--                        android:layout_marginBottom="18dp" />-->

                    <!-- Base Price -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base Price"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card_white_rounded"
                        android:backgroundTint="#F5F6FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textSize="14sp"
                            android:textColor="#888888"
                            android:layout_marginEnd="6dp" />

                        <EditText
                            android:id="@+id/et_base_price"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:textColorHint="#BBBBBB"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:background="@null"
                            android:singleLine="true"
                            android:inputType="numberDecimal"
                            android:padding="0dp" />

                    </LinearLayout>

                    <!-- Discount % -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discount % (Optional)"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card_white_rounded"
                        android:backgroundTint="#F5F6FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="18dp">

                        <EditText
                            android:id="@+id/et_discount"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="0"
                            android:textColorHint="#BBBBBB"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:background="@null"
                            android:singleLine="true"
                            android:inputType="number"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textSize="14sp"
                            android:textColor="#888888"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="Describe the craftsmanship, materials, and fit..."
                        android:textColorHint="#BBBBBB"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:background="@drawable/bg_card_white_rounded"
                        android:backgroundTint="#F5F6FA"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Product Variants Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Product Variants"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <LinearLayout
                    android:id="@+id/btn_add_variant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/ic_add"

                        app:tint="@color/primary"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Variant"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                </LinearLayout>

            </RelativeLayout>

            <!-- Variant 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <!-- Color Swatch -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_rounded_bg"
                        android:backgroundTint="@color/primary"
                        android:layout_marginEnd="12dp" />

                    <!-- Variant Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Midnight Navy · XL"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock: 24 • Active"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Edit / Delete -->
                    <ImageView
                        android:id="@+id/btn_edit_variant1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_edit"
                        app:tint="#888888"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:id="@+id/btn_delete_variant1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_delete"
                        app:tint="#E53935" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Variant 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <!-- Color Swatch -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_rounded_bg"
                        android:backgroundTint="@color/primary"
                        android:layout_marginEnd="12dp" />

                    <!-- Variant Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloud White · M"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock: 12 • Active"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Edit / Delete -->
                    <ImageView
                        android:id="@+id/btn_edit_variant2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_edit"
                        app:tint="#888888"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:id="@+id/btn_delete_variant2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_delete"
                        app:tint="#E53935" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Discard -->
        <LinearLayout
            android:id="@+id/btn_discard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="25dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_delete"
                 />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discard"
                android:textSize="11sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Save Product -->
        <Button
            android:id="@+id/btn_save_product"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Save Product"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="#FFFFFF"

            android:drawablePadding="8dp"
            android:backgroundTint="@color/primary"
            app:cornerRadius="26dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>