<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fontFamily="@font/manrope_bold"
            android:paddingLeft="140dp"
            android:text="SHOPIX"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginEnd="20dp"
            app:fontFamily="@font/manrope_bold"
            android:text="Skip"
            android:textColor="@color/primary"/>
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="350dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_rounded_bg"
        android:padding="24dp"
        android:layout_below="@id/toolbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20sp"
        >

        <ImageView
            android:id="@+id/image"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:padding="8dp"
            android:src="@drawable/img_image2" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="100dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:fontFamily="@font/manrope_bold"
            android:text="Discover Great Products"
            android:textColor="@color/primary"
            android:textSize="30sp"
            />

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse a wide variety of products "/>
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From trusted dellers"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All in one place." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="Next"
            android:textSize="20dp"
            app:cornerRadius="30dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="4dp" />

    </LinearLayout>


</RelativeLayout>