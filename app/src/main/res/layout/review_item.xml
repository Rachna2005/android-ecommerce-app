<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
android:background="@color/white"

    android:layout_marginBottom="20dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/userName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="- Marcus Thorne."
            android:textSize="18dp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />

        </LinearLayout>

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="post at 12-04-2026"
            android:textColor="@android:color/darker_gray"/>

    </LinearLayout>

    <TextView
        android:id="@+id/review"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/content"

        android:layout_marginTop="6dp"

        android:text="The scraftsmanship is unmatched, A true masterpice of minimalist design." />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/review"
        android:background="@color/stroke_default"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        />

</RelativeLayout>
