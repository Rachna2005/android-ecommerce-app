                    <!--                        android:layout_weight="1"-->
                    <!--                        android:gravity="end"-->
                    <!--                        android:text="See More"-->
                    <!--                        android:textColor="@color/primary" />-->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
