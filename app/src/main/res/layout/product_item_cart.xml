<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="0dp">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <!-- Product Image -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="#F5F5F5"
            android:scaleType="centerCrop"
            android:src="@drawable/img_product_detail"
            android:layout_marginTop="8dp"/>

        <!-- Favorite + Delete -->
        <LinearLayout
            android:id="@+id/btnIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:layout_marginBottom="30dp">

<!--            <ImageView-->
<!--                android:id="@+id/btn_favorite"-->
<!--                android:layout_width="20dp"-->
<!--                android:layout_height="20dp"-->
<!--                android:layout_marginEnd="8dp"-->
<!--                android:src="@drawable/ic_heart" />-->
<!--            <FrameLayout-->
<!--                android:layout_width="20dp"-->
<!--                android:layout_height="20dp"-->
<!--                android:layout_marginEnd="15dp">-->

<!--                <ImageView-->
<!--                    android:id="@+id/btn_favorite"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:src="@drawable/ic_heart"-->
<!--                    android:scaleType="centerInside"/>-->

<!--                <ProgressBar-->
<!--                    android:id="@+id/favorite_loading"-->
<!--                    android:layout_width="14dp"-->
<!--                    android:layout_height="14dp"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:visibility="gone"/>-->

<!--            </FrameLayout>-->

                <ImageView
                    android:id="@+id/btn_delete"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_delete"
                  />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stepper"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/btnIcon"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stepper_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:layout_marginBottom="5dp"
           >
            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp">

                <TextView
                    android:id="@+id/decrease"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="−"
                    android:textStyle="bold"

                    android:textSize="18sp" />
                <ProgressBar
                    android:id="@+id/decreaseLoading"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView
                android:id="@+id/quantityNum"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"

                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp">

                <TextView
                    android:id="@+id/increase"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="+"
                  android:textStyle="bold"
                    android:textSize="18sp" />

                <ProgressBar
                    android:id="@+id/increaseLoading"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/image"
            android:layout_toStartOf="@id/btnIcon"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Stratus Runner"
                android:textColor="@color/primary"
                app:fontFamily="@font/manrope_bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/variant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crimson Red, 42 EU"
                android:textColor="#888888"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" x "
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#888888"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/totalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="$189.00"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/stepper"
            android:background="@color/stroke_default" />
    </RelativeLayout>

</androidx.cardview.widget.CardView>