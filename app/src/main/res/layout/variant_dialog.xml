<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ndroid="http://schemas.android.com/tools"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="18dp" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Variant"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginLeft="100dp"

                    />
                <ImageView
                    android:id="@+id/close"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_close_small"
                    android:layout_marginLeft="60dp"
                   />
            </LinearLayout>

            <!-- Product Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textSize="13sp"
                app:fontFamily="@font/manrope_bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_color"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Black"
                android:textColorHint="#BBBBBB"
                android:textColor="#111111"
                android:textSize="14sp"
                android:background="@drawable/bg_card_white_rounded"
                android:backgroundTint="#F5F6FA"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textSize="13sp"
                app:fontFamily="@font/manrope_bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_white_rounded"
                android:backgroundTint="#F5F6FA"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="18dp">



                <EditText
                    android:id="@+id/et_size"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="M"
                    android:textColorHint="#BBBBBB"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:background="@null"
                    android:singleLine="true"
                    android:inputType="text|number"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Discount % -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock"
                android:textSize="13sp"
            app:fontFamily="@font/manrope_bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_white_rounded"
                android:backgroundTint="#F5F6FA"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="18dp">

                <EditText
                    android:id="@+id/et_stock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="0"
                    android:textColorHint="#BBBBBB"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:background="@null"
                    android:singleLine="true"
                    android:inputType="number"
                    android:padding="0dp" />

            </LinearLayout>
            <Button
                android:id="@+id/btn_create"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Create Variant"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="#FFFFFF"
                android:drawablePadding="8dp"
                android:backgroundTint="@color/primary"
                app:cornerRadius="22dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_gravity="center_horizontal"
                android:stateListAnimator="@null" />
        </LinearLayout>
</androidx.cardview.widget.CardView>