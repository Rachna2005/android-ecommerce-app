<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- your existing theme items -->
    </style>

    <!-- Add this -->
    <style name="NoIndicator" parent="">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:height">0dp</item>
        <item name="shapeAppearance">@null</item>
    </style>

    <style name="AppTextViewStyle">
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/manrope_medium</item>
    </style>

    <style name="AppEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="hintTextAppearance">@font/manrope_medium</item>

<!--        <item name="hintTextColor">@color/text_secondary</item>-->

    </style>

</resources>